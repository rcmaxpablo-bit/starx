const test = require("node:test");
const assert = require("node:assert/strict");
const { EventEmitter } = require("node:events");
const { ComponentType, Events } = require("discord.js");

function createClient() {
  const client = new EventEmitter();
  client.user = { id: "bot" };
  client.channels = { fetch: async () => null };
  client.isReady = () => false;
  return client;
}

test("kalkulator prowizji otwiera formularz z listami wyboru", async () => {
  const client = createClient();
  require("../obliczprowizje")(client);

  let modal;
  const interaction = {
    customId: "calc_type",
    values: ["otrzymam"],
    isStringSelectMenu: () => true,
    isModalSubmit: () => false,
    showModal: async value => {
      modal = value.toJSON();
    }
  };

  const listeners = client.listeners(Events.InteractionCreate);
  assert.equal(listeners.length, 1);

  await listeners[0](interaction);

  assert.ok(modal, "Formularz kalkulatora nie został wyświetlony");
  assert.equal(modal.custom_id, "calc_modal_otrzymam");
  assert.equal(modal.components.length, 3);
  assert.ok(modal.components.every(component => component.type === ComponentType.Label));

  const [amount, from, to] = modal.components;
  assert.equal(amount.component.type, ComponentType.TextInput);
  assert.equal(amount.component.custom_id, "amount");

  const expectedMethods = ["BLIK", "KODBLIK", "PSC", "PAYPAL", "CRYPTO", "SKRILL"];
  for (const [component, customId] of [[from, "from"], [to, "to"]]) {
    assert.equal(component.component.type, ComponentType.StringSelect);
    assert.equal(component.component.custom_id, customId);
    assert.deepEqual(component.component.options.map(option => option.value), expectedMethods);
  }
});

test("moduł cennik nie dubluje obsługi komendy autolc", () => {
  const client = createClient();
  require("../cennik")(client);
  assert.equal(client.listenerCount(Events.InteractionCreate), 0);
});
