const test = require('node:test');
const assert = require('node:assert/strict');
const { EventEmitter } = require('node:events');
const Module = require('node:module');

class Builder {
  constructor() {
    this.data = {};
  }
  setColor(value) { this.data.color = value; return this; }
  setTitle(value) { this.data.title = value; this.title = value; return this; }
  setDescription(value) { this.data.description = value; return this; }
  setImage(value) { this.data.image = value; return this; }
  setFooter(value) { this.data.footer = value; return this; }
  setCustomId(value) { this.data.custom_id = value; this.customId = value; return this; }
  setPlaceholder(value) { this.data.placeholder = value; return this; }
  addOptions(value) { this.data.options = Array.isArray(value) ? value : [...arguments]; return this; }
  addComponents(...value) { this.components = value.flat(); return this; }
}

function loadCennik() {
  const originalLoad = Module._load;

  Module._load = function mockedLoad(request, parent, isMain) {
    if (request === 'discord.js') {
      return {
        EmbedBuilder: Builder,
        ActionRowBuilder: Builder,
        StringSelectMenuBuilder: Builder,
        Events: {
          ClientReady: 'ready',
          InteractionCreate: 'interactionCreate'
        }
      };
    }

    if (request === './panelManager' && parent?.filename?.endsWith('cennik.js')) {
      return {
        upsertPanel: async () => ({ id: 'cennik-panel-1' })
      };
    }

    return originalLoad.call(this, request, parent, isMain);
  };

  const path = require.resolve('../cennik');
  delete require.cache[path];
  const setup = require('../cennik');
  Module._load = originalLoad;
  return setup;
}

function makeClient() {
  const client = new EventEmitter();
  client.channels = {
    fetch: async () => ({
      isTextBased: () => true,
      send: async () => ({ id: 'sent-panel' })
    })
  };
  return client;
}

function makeInteraction(overrides = {}) {
  const interaction = {
    customId: 'starx_cennik',
    channelId: '1499902366843932763',
    values: ['streaming'],
    message: { embeds: [{ title: '🌟 StarX Exchange » CENNIK' }] },
    deferred: false,
    replied: false,
    isStringSelectMenu: () => true,
    deferReply: async options => {
      assert.equal(options.flags, 64);
      interaction.deferred = true;
    },
    editReply: async payload => {
      interaction.edited = payload;
      return payload;
    },
    followUp: async payload => {
      interaction.followedUp = payload;
      return payload;
    },
    reply: async payload => {
      interaction.repliedPayload = payload;
      interaction.replied = true;
      return payload;
    },
    ...overrides
  };

  return interaction;
}

test('cennik rejestruje listener interactionCreate jako pierwszy', () => {
  const setup = loadCennik();
  const client = makeClient();
  setup(client);

  assert.equal(client.listeners('interactionCreate').length, 1);
});

test('aktualne menu cennika jest od razu potwierdzane i odpowiada embedem', async () => {
  const setup = loadCennik();
  const client = makeClient();
  setup(client);

  const interaction = makeInteraction();
  await client.listeners('interactionCreate')[0](interaction);

  assert.equal(interaction.deferred, true);
  assert.equal(interaction.edited?.embeds?.length, 1);
  assert.match(interaction.edited.embeds[0].data.title, /STREAMING/);
});

test('stary customId panelu działa po kanale i tytule CENNIK', async () => {
  const setup = loadCennik();
  const client = makeClient();
  setup(client);

  const interaction = makeInteraction({
    customId: 'bardzo_stary_id_cennika',
    values: ['vpn']
  });

  await client.listeners('interactionCreate')[0](interaction);

  assert.equal(interaction.deferred, true);
  assert.match(interaction.edited.embeds[0].data.title, /VPN/);
});

test('obce menu nie jest przejmowane przez moduł cennika', async () => {
  const setup = loadCennik();
  const client = makeClient();
  setup(client);

  const interaction = makeInteraction({
    customId: 'inne_menu',
    channelId: 'inny-kanal',
    message: { embeds: [{ title: 'INNY PANEL' }] }
  });

  await client.listeners('interactionCreate')[0](interaction);

  assert.equal(interaction.deferred, false);
  assert.equal(interaction.edited, undefined);
});
